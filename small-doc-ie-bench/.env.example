# Service
APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8080
MAX_UPLOAD_MB=25
RAW_DOCUMENT_STORAGE=disabled

# Security / auth
# Fails closed by default: every /v1 route (extraction, schemas, reviews,
# workers, studio, serving) requires a valid X-API-Key header. For local
# single-operator dev, set AUTH_REQUIRED=false to disable it. For any shared or
# networked run, leave it true and populate API_KEYS.
AUTH_REQUIRED=false
# JSON object {"<secret-key>": "<tenant-id>"} or "key1:tenantA,key2:tenantB".
# The matched tenant id becomes the worker/reviewer provenance recorded on tasks.
# The Studio UI has a key icon in its top bar (frontend/components/shell/
# ApiKeyDialog.tsx) where the operator pastes one of these keys so the browser
# sends it as X-API-Key once AUTH_REQUIRED=true.
API_KEYS=
# Inference and mutation requests retain the tighter tenant budget. Studio
# GET/HEAD polling uses an independent read bucket so live screens cannot
# exhaust the inference quota simply by remaining open.
RATE_LIMIT_REQUESTS=60
TENANT_READ_RATE_LIMIT_REQUESTS=600
RATE_LIMIT_WINDOW_SECONDS=60
TENANT_MAX_CONCURRENT_REQUESTS=4
# CORS origins allowed to call the API from a browser (the DocIE Studio UI).
# Comma-separated. UNSET now means localhost-only (http://localhost:3000,
# http://127.0.0.1:3000) — a deliberate hardening from the old "*" default. If
# you serve the Studio UI from another host, set the browser origin(s) here
# explicitly (or "*" to allow any, only safe because auth is header-based).
STUDIO_CORS_ORIGINS=

# Database
# REQUIRED — docker-compose.yml's postgres and inngest services both read
# POSTGRES_PASSWORD; there is no more insecure "docie"/"docie" fallback baked
# into the compose file, so `docker compose up` fails fast with a clear error
# if it's unset. Pick a real password: `openssl rand -hex 32` (same generator
# this file already tells you to use for INNGEST_EVENT_KEY/SIGNING_KEY below —
# hex avoids `/`/`+`/`=` characters that would break the postgres:// URIs this
# gets interpolated into). Do this even for solo local dev; it's cheap.
#
# Upgrading an EXISTING stack: POSTGRES_PASSWORD only takes effect the first
# time Postgres initializes its data directory. If you already have a
# `postgres-data` volume, setting this alone won't change the running
# server's password — either change it in place:
#   docker compose exec postgres psql -U docie -d docie -c \
#     "ALTER USER docie WITH PASSWORD '<new-password>';"
# or remove the `postgres-data` volume to reinitialize from scratch (data
# loss).
POSTGRES_PASSWORD=
# Host-native processes can read this value from `.env`. Compose constructs and
# pins the same URL directly in api/serving/worker/bench so deployment platforms
# cannot collapse the nested ${POSTGRES_PASSWORD} reference while generating
# their runtime env file. There is still one password source and no manual sync.
# If DATABASE_URL is left unset for a host-native process, Studio persistence
# (review workflow, run index, model catalog) degrades gracefully to a
# best-effort/in-memory mode rather than failing outright.
DATABASE_URL=postgresql+psycopg://docie:${POSTGRES_PASSWORD}@postgres:5432/docie
REVIEW_CLAIM_LEASE_SECONDS=900
REVIEW_CONFIDENCE_THRESHOLD=0.7
REVIEW_EVIDENCE_THRESHOLD=0.8
ANNOTATION_EXPORT_DIR=/app/annotations

# Default extraction
DEFAULT_SCHEMA_NAME=invoice
DEFAULT_MODEL_PROFILE=local_llamacpp
DEFAULT_OCR_BACKEND=pdf_text
OCR_CACHE_ENABLED=true
OCR_CACHE_MAX_MB=2048
OCR_CACHE_DIR=/app/.cache/ocr
RUNS_DIR=/app/runs

# Durable Studio artifact store (shared across api + worker). Must resolve to the
# SAME location on every replica; swap for an S3/MinIO mount for multi-host.
ARTIFACT_STORE_DIR=/app/artifacts
# Retention/GC for the Studio run index (nightly gc_studio_runs_job). Age wins
# first, then a hard cap on run count.
STUDIO_RUN_RETENTION_DAYS=30
STUDIO_RUN_RETENTION_MAX=500

# LLM: OpenAI-compatible endpoint
OPENAI_COMPAT_BASE_URL=http://llm-llamacpp:8000/v1
OPENAI_COMPAT_API_KEY=local-not-used
OPENAI_COMPAT_MODEL=local-model
OPENAI_COMPAT_TIMEOUT_SECONDS=180
# llama-cpp-python / vLLM support the stronger openai_json_schema; some backends
# (notably Ollama) reject a strict json_schema with HTTP 400 "failed to parse
# grammar" -- for those set OPENAI_COMPAT_RESPONSE_FORMAT_STYLE=json_object.
OPENAI_COMPAT_RESPONSE_FORMAT_STYLE=openai_json_schema

# Local llama.cpp server container
MODEL_PATH=/models/model.gguf
LLAMA_CPP_N_CTX=4096
LLAMA_CPP_N_THREADS=12
LLAMA_CPP_N_BATCH=256
LLAMA_CPP_HOST=0.0.0.0
LLAMA_CPP_PORT=8000

# Observability. Leave this empty for the default single-process Uvicorn API.
# Set it only when running multiple Python worker processes that share a
# writable directory; the application creates the configured path at startup.
PROMETHEUS_MULTIPROC_DIR=
OTEL_SERVICE_NAME=small-doc-ie-bench

# Inngest (DocIE Studio async processing)
# Keys must be hex strings with an EVEN number of chars: `openssl rand -hex 32`.
# Shared by the inngest server, the worker, and the API (event sending).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# 0 = production (self-hosted server, keys required). Set 1 only for the local
# `npx inngest-cli dev` workflow.
INNGEST_DEV=0
# Two Inngest apps, one per role (PR-1 service split): the scaled `worker`
# fleet registers INNGEST_APP_ID (extraction/benchmark/GC) and the
# single-replica `serving` service registers INNGEST_SERVING_APP_ID
# (deploy/seed/delete + reconciler). They MUST stay distinct: an Inngest app's
# function set is re-registered on every worker sync, so two fleets syncing
# disjoint function lists under ONE app id would overwrite each other's
# registration on every reconnect (functions flap between registered and
# archived). Events route by name, not app, so triggers are unaffected.
INNGEST_APP_ID=docie-studio
INNGEST_SERVING_APP_ID=docie-serving
# How the worker/API reach the self-hosted server (internal Docker service
# names + INTERNAL container ports 8288/8289 — NOT the host-published ports).
INNGEST_BASE_URL=http://inngest:8288
INNGEST_CONNECT_GATEWAY_URL=ws://inngest:8289/v0/connect

# Host ports for the Inngest dashboard/gateway (override to avoid clashes).
# Distinct from the server's own INNGEST_PORT, which must stay 8288 internally.
INNGEST_HOST_PORT=8288
INNGEST_CONNECT_HOST_PORT=8289

# BROWSER-reachable Inngest API for the Studio's REALTIME live progress (seed /
# deploy / benchmark bars). The @inngest/realtime browser hook reads exactly
# this env name; if it is unset the lib defaults to Inngest Cloud
# (api.inngest.com) and a self-hosted-minted token's WebSocket is refused, so the
# UI silently degrades to /runs polling (still works — coarser). Set it to the
# host-published Inngest API port (INNGEST_HOST_PORT), NOT the internal docker
# name (ws://inngest:8289) which the browser cannot resolve. NEXT_PUBLIC_* is
# baked into the web bundle at BUILD time, so change it via the web build arg and
# rebuild the web image. (Realtime on the self-hosted Inngest server also depends
# on that server version implementing the realtime endpoint; if it does not, the
# socket still closes and polling remains the fallback.)
NEXT_PUBLIC_INNGEST_BASE_URL=http://localhost:8288

# Serving/deploy state (shared by api + serving + worker via the serving-state
# volume). The GGUF blob store lives under $DOCIE_SERVING_HOME/models; its
# metadata is cataloged in Postgres (requires DATABASE_URL). `llama-server`
# ships in the serving image. Runtime lifecycle (deploy/seed/delete + the
# background reconciler) runs ONLY on the dedicated single-replica `serving`
# service; `worker` scales freely for extraction/benchmark (docker-compose.yml).
DOCIE_SERVING_HOME=/app/.serving

# Cross-container serving reachability. A deployed runtime BINDS
# DOCIE_SERVING_BIND_HOST (all interfaces inside its container) while the
# DeploymentRecord ADVERTISES the single-replica `serving` service name, which
# ALWAYS resolves to the one node that ran the deploy, so siblings reach it at
# e.g. `serving:8088` over the compose network (no published port).
#
# MIGRATION NOTE (PR-1 service split — upgrade trap): a .env written before
# the split carried DOCIE_SERVING_ADVERTISE_HOST=worker. That variable is now
# IGNORED by the serving compose service, which pins its own advertise name
# (`serving`) in docker-compose.yml precisely so a stale .env cannot make
# deploys advertise the freely-scaled worker service (a round-robin endpoint
# that may resolve to a replica that never ran the deploy). Delete any old
# DOCIE_SERVING_ADVERTISE_HOST line from your .env; if you rename the serving
# service, set DOCIE_SERVING_ADVERTISE_HOST_OVERRIDE to the new name. The
# serving process additionally warns at startup when its advertise host names
# a scaled service, and refuses such deploys once the name resolves to more
# than one address.
#DOCIE_SERVING_ADVERTISE_HOST_OVERRIDE=serving
#
# SECURITY: bind/advertise default to the safe loopback 127.0.0.1 in code, so a
# local `docie up`/`docie serve` never exposes the unauth runtime on the LAN.
# Setting BIND=0.0.0.0 here is a deliberate opt-in for the Docker path ONLY, and
# is safe because the runtime is reachable solely on the private compose network
# (there is no `ports:` mapping for it). Do NOT set BIND=0.0.0.0 outside a
# private container network. Leave everything unset for the local CLI, which
# stays same-host on 127.0.0.1.
DOCIE_SERVING_BIND_HOST=0.0.0.0

# Background reconciler cadence on the `serving` service (seconds between
# observation cycles: liveness/RSS publish + gated repair). The api also reads
# this to gate node-snapshot staleness: /resources and /sizing stop trusting a
# snapshot older than 3x this interval (floor 30s) — a dead reconciler must
# degrade to "observed unavailable", never keep serving its last number.
DOCIE_SERVING_RECONCILE_INTERVAL=10

# Hard memory limit for the `serving` container (PR-2 resource tracker). With
# an explicit limit the container's cgroup-v2 numbers become the authoritative
# sizing denominator (published as source=cgroup); without one the cgroup
# reads the "max" sentinel and the tracker falls back to the elastic Docker
# Desktop/WSL2 VM view (source=vm, badged as a soft number in the UI). Size it
# to the RAM you actually grant the GGUF runtimes: roughly the sum over
# co-resident deployments of (weights + KV cache + ~0.5 GB runtime slab).
# MUST NOT exceed the WSL2 VM's own memory (default: 50% of host RAM): a limit
# larger than the VM never binds, so the tracker would publish a ceiling the
# node cannot deliver. Grow the VM first via %UserProfile%\.wslconfig
# ([wsl2] memory=24GB, then `wsl --shutdown`) before raising this.
DOCIE_SERVING_MEM_LIMIT=8g

# llama.cpp pin for the serving image's llama-server (build-arg). Empty = latest
# master HEAD, but the clone+build layer is Docker-CACHED, so `docker compose
# build serving` reuses the old binary even after upstream moves. To pick up a
# new architecture (e.g. Unlimited-OCR / deepseek-ocr, llama.cpp#24969 merged
# 2026-06-24), set a commit/tag AFTER that merge — the changed value busts the
# cache and rebuilds llama.cpp at the pin (reproducible):
#   LLAMA_REF=<commit-or-tag>   then  docker compose build serving
#LLAMA_REF=

# Sizing safety margin (PR-3): the fraction of node TOTAL RAM the Sizing tab /
# fit gate holds back before pricing prospective instances (fits = floor(
# (free - margin) / footprint)). Explicit and surfaced in the API/UI — an
# honest buffer, never a hidden fudge factor. Design brackets 10-15%; default
# is the low end.
DOCIE_SIZING_MARGIN_FRACTION=0.10

# Dynamic lifecycle (PR-4). Idle-TTL unload: a hot, unpinned deployment that
# served nothing for this long is unloaded by the reconciler — the process is
# killed but the record, its port and its placement row are KEPT
# (phase=evicted, activation=managed), so the next request to it auto-reloads
# instead of failing. 0 disables idle unload. TTFT of that first request after
# an unload = model load time (explicitly accepted).
#
# DEMO / low-traffic note: at the 900s (15min) default, a model sitting idle
# between clicks gets offloaded — great for RAM reclaim, surprising in a demo.
# Set 0 to disable idle unload entirely, or Pin the deployment (Deployments
# tab) to shield a specific model regardless of this value.
DOCIE_SERVING_IDLE_TTL_SECONDS=900
# Anti-thrash guard: a deployment hot for less than this is never idle-unloaded
# or picked as an eviction victim.
DOCIE_SERVING_MIN_HOT_SECONDS=120
# Eviction storm guard: at most this many LRU victims per load attempt; when
# the allowed victims cannot make the candidate fit, NOTHING is evicted
# (never evict-to-not-fit). Pinned deployments are never victims.
DOCIE_SERVING_MAX_EVICTIONS_PER_CYCLE=2

# Per-deploy port allocation window (PR-B). A deploy that supplies no explicit
# port is auto-assigned the first free port in [START, END] that is neither held
# by a non-removed deployment record nor bound by a live socket, so two concurrent
# store deploys land on distinct ports with no operator input. 8088 stays the
# first pick, so a single deploy is unchanged. Widen the window (or stop a
# deployment) if it exhausts. An explicit --port / port= is always honored
# verbatim (the bind arbitrates conflicts; the real llama-server stderr is then
# surfaced onto the deployment's last_error). Best-effort, not race-free: a probed
# port can be grabbed before the runtime binds, and a worker cannot see a
# concurrent host-native `docie up`, so the bind is the authoritative arbiter and
# a bind-collision exit triggers a bounded reallocation.
DOCIE_SERVING_PORT_RANGE_START=8088
DOCIE_SERVING_PORT_RANGE_END=8188

# Host Ollama models dir (read-only mount) so "seed from Ollama" can hard-link
# existing GGUF blobs into the store without re-downloading. No cross-platform
# default (Docker bind mounts don't expand ~), so leave this unset unless you
# use seed-from-Ollama: Linux/macOS default is /root/.ollama/models (matches
# the compose fallback below), Windows needs an explicit forward-slash path,
# e.g. C:/Users/<you>/.ollama/models.
#OLLAMA_MODELS_HOST=

# Host port publishing for postgres/prometheus/grafana (docker-compose.yml).
# All three are bound to 127.0.0.1 in the compose file by default — reachable
# from the host machine, not from the LAN/internet — because postgres uses
# real credentials but is still worth not exposing, prometheus has no auth at
# all, and grafana runs with anonymous Viewer access (needed for the Studio
# Observability tab's iframe embed). These vars only change the port number;
# to publish on all interfaces instead of loopback, edit the host binding in
# docker-compose.yml directly, and only do that if you've put something else
# (reverse proxy, firewall/ACL, VPN) in front of it.
POSTGRES_PORT=5432
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Sandboxed code execution (docker-compose.yml's judge0-* services, opt-in
# via `docker compose --profile sandbox up`, backing the code_interpreter
# MCP tool, #264 — see docs/adr-agent-sandboxing.md). Unset means those
# services never start with auth/passwords configured, which is fine as
# long as you never pass --profile sandbox; set all three with
# `openssl rand -hex 32` before you do. Not shared with the app's own
# POSTGRES_PASSWORD/redis — judge0 gets its own dedicated db/queue.
#JUDGE0_AUTH_TOKEN=
#JUDGE0_POSTGRES_PASSWORD=
#JUDGE0_REDIS_PASSWORD=
