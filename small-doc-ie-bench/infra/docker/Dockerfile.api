# syntax=docker/dockerfile:1

# Fast path: reuse llama.cpp's official CPU server-only image. Override with a
# pinned tag/digest for reproducible builds. The image exposes llama-server and
# its shared libraries under /app (the upstream server-image contract).
ARG LLAMA_SERVER_IMAGE=ghcr.io/ggml-org/llama.cpp:server

# Build a portable, statically-linked llama-server (CPU) once. This stage has no
# dependency on the app source, so it caches across code changes and only
# rebuilds if these lines change. GGML_NATIVE=OFF keeps the binary portable
# across CPUs; BUILD_SHARED_LIBS=OFF avoids chasing .so files at runtime.
FROM python:3.11-slim-bookworm AS llama-builder
# Bound the compile parallelism. `cmake --build -j` (unbounded) spawns one g++
# per core; the memory-heavy models/*.cpp batch then peaks well past a
# memory-limited Docker VM's cap and the OOM-killer stalls the build around
# 65-70% (looks like a hang). Default to 2 concurrent jobs (~2-4GB peak, works
# on a stock Docker Desktop). Override on a roomier machine for speed:
#   docker compose build --build-arg LLAMA_BUILD_JOBS=8 worker
ARG LLAMA_BUILD_JOBS=2
# Pin llama.cpp to a commit/tag for REPRODUCIBLE builds AND to force a rebuild
# of this (Docker-cached) layer when a needed upstream feature lands. Empty
# (default) keeps the old behavior — the latest master HEAD, cached forever
# once built. IMPORTANT: because the clone-and-build below is one RUN whose
# text never changes, a plain `docker compose build` REUSES the cached
# llama-server even after upstream HEAD moves. To pick up a new arch (e.g.
# Unlimited-OCR / deepseek-ocr, ggml-org/llama.cpp#24969, merged 2026-06-24),
# set LLAMA_REF to a commit/tag AFTER that merge — the changed ARG busts this
# layer's cache and rebuilds llama.cpp at the pin:
#   docker compose build --build-arg LLAMA_REF=<commit-or-tag> serving
# (or `docker compose build --no-cache serving`, but that rebuilds everything).
ARG LLAMA_REF=
RUN apt-get update && apt-get install -y --no-install-recommends \
    git build-essential cmake ca-certificates \
  && rm -rf /var/lib/apt/lists/*
# A pinned ref is shallow-fetched (only that commit — GitHub allows any-SHA
# fetch), so pinning stays as cheap as the --depth 1 clone.
RUN if [ -n "${LLAMA_REF}" ]; then \
      git init /src \
      && git -C /src remote add origin https://github.com/ggml-org/llama.cpp \
      && git -C /src fetch --depth 1 origin "${LLAMA_REF}" \
      && git -C /src checkout FETCH_HEAD; \
    else \
      git clone --depth 1 https://github.com/ggml-org/llama.cpp /src; \
    fi \
 && cmake -S /src -B /src/build \
      -DCMAKE_BUILD_TYPE=Release \
      -DBUILD_SHARED_LIBS=OFF \
      -DLLAMA_CURL=OFF \
      -DGGML_NATIVE=OFF \
 && cmake --build /src/build --target llama-server -j "${LLAMA_BUILD_JOBS}"

FROM ${LLAMA_SERVER_IMAGE} AS llama-prebuilt

# Upstream's official server image is Ubuntu 24.04 and currently requires
# glibc >= 2.38. Debian Trixie supplies a compatible glibc while retaining the
# project's Python 3.11 runtime; Bookworm's glibc 2.36 cannot load the prebuilt
# server libraries.
FROM python:3.11-slim-trixie AS app-runtime

# NOTE: no PIP_NO_CACHE_DIR — the dependency layer below uses a BuildKit cache
# mount for /root/.cache/pip, so wheels (torch is ~200MB even CPU-only) are
# downloaded once and reused across rebuilds without growing the image.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libmagic1 \
    poppler-utils \
    tesseract-ocr \
    tesseract-ocr-eng \
    tesseract-ocr-fra \
    libssl3t64 \
    libstdc++6 \
    libgomp1 \
  && rm -rf /var/lib/apt/lists/*

# PIP_EXTRAS lets one service opt into heavier optional groups without
# bloating every image built from this file. The `serving` service defaults to
# "ocr,encoders" (torch + GLiNER for encoder deployments), but deployments can
# set DOCIE_SERVING_EXTRAS=ocr to omit that heavy feature; other services keep
# the light default.
ARG PIP_EXTRAS=ocr

# ── Dependency layer ─────────────────────────────────────────────────────────
# Installed from pyproject BEFORE the source copy, so editing code never
# re-resolves (or re-downloads) the dependency world. Two deliberate moves:
#   * CPU-only torch is pinned FIRST when the encoders extra is requested —
#     otherwise gliner/gliner2 pull the default CUDA build and its multi-GB
#     nvidia-cudnn/cublas wheels, which this CPU-only stack never executes.
#   * the pip download cache is a BuildKit cache mount: even when this layer
#     is invalidated (dependency bump), wheels come from the local cache
#     instead of the network.
COPY pyproject.toml README.md ./
COPY scripts/print_requirements.py ./scripts/print_requirements.py
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip \
 && case ",${PIP_EXTRAS}," in \
      *,encoders,*) pip install --index-url https://download.pytorch.org/whl/cpu torch ;; \
    esac \
 && python scripts/print_requirements.py "${PIP_EXTRAS}" > /tmp/requirements.txt \
 && pip install -r /tmp/requirements.txt

# ── Source layer ─────────────────────────────────────────────────────────────
# Code-only changes rebuild from here: --no-deps because everything third-party
# is already satisfied above (seconds, no network).
COPY src ./src
COPY scripts ./scripts
RUN pip install --no-deps -e .

COPY configs ./configs

EXPOSE 8080

# Lightweight target for API, workload-worker, and benchmark deployments.
# Crucially, this target does not depend on llama-builder, so BuildKit skips the
# llama.cpp clone/compile entirely when a deployment does not include the local
# model-serving segment.
FROM app-runtime AS api-runtime

# Custom-build path: compile the requested LLAMA_REF locally. This remains
# available for architecture patches or build flags not present upstream.
FROM app-runtime AS serving-runtime-source
COPY --from=llama-builder /src/build/bin/llama-server /usr/local/bin/llama-server

# Default serving path: copy the official server-only runtime instead of
# cloning and compiling llama.cpp. The shared libraries live beside the small
# launcher, matching the upstream image layout.
FROM app-runtime AS serving-runtime-prebuilt
COPY --from=llama-prebuilt /app /opt/llama.cpp
ENV LD_LIBRARY_PATH=/opt/llama.cpp
RUN ln -s /opt/llama.cpp/llama-server /usr/local/bin/llama-server \
 && llama-server --version
